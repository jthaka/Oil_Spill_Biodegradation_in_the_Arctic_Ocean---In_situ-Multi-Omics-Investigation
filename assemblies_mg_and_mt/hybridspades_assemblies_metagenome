#Requires short-read and longread sequences

#Load required environment in DRAC cluster
module load spades

#Set required inputs
sample_list=path/to/sample/list.txt
r1=path/to/forward/reads/${sample}_R1.fastq.gz
r2=path/to/reverse/reads/${sample}_R2.fastq.gz
nano=path/to/nanopore/reads/${sample}.fastq.gz
outdir=path/to/desired/output/dir
mkdir -p ${outdir}

sample=$(sed -n "${SLURM_ARRAY_TASK_ID}p" ${sample_list})

# Run HybridSPAdes
metaspades.py \
  -1 ${r1}\
  -2 ${r2} \
--nanopore ${nano} \
  -o ${outdir} \
  --meta \
  -k 33,55,77,99,127 \
  -m 90 \
  -t 32 \
  --only-assembler
